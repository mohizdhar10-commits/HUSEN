rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             data.email is string && data.email.size() <= 120 &&
             data.planTier in ['FREE', 'PRO', 'UNLIMITED'] &&
             data.credits is int && data.credits >= 0 && data.credits <= 10000 &&
             data.totalGenerations is int && data.totalGenerations >= 0 && data.totalGenerations <= 100000 &&
             data.preferredLanguage in ['id', 'en'] &&
             data.darkTheme is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidStudioProject(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.projectType in ['TEXT_TO_VIDEO', 'IMAGE_TO_VIDEO', 'IMAGE_GEN', 'IMAGE_EDIT', 'SCRIPT', 'VOICEOVER'] &&
             data.prompt is string && data.prompt.size() >= 1 && data.prompt.size() <= 2000 &&
             (!('enhancedPrompt' in data) || (data.enhancedPrompt is string && data.enhancedPrompt.size() <= 3000)) &&
             data.style is string && data.style.size() <= 60 &&
             data.aspectRatio in ['16:9', '9:16', '1:1'] &&
             data.resolution in ['360p', '720p', '1080p', '1K'] &&
             data.status in ['QUEUED', 'PROCESSING', 'COMPLETED', 'FAILED'] &&
             data.creditCost is int && data.creditCost >= 0 && data.creditCost <= 100 &&
             (!('localMediaPath' in data) || (data.localMediaPath is string && data.localMediaPath.size() <= 500)) &&
             (!('interactionId' in data) || (data.interactionId is string && data.interactionId.size() <= 200)) &&
             (!('scriptJson' in data) || (data.scriptJson is string && data.scriptJson.size() <= 15000)) &&
             (!('subtitlesJson' in data) || (data.subtitlesJson is string && data.subtitlesJson.size() <= 15000)) &&
             (!('errorMessage' in data) || (data.errorMessage is string && data.errorMessage.size() <= 500)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'email', 'planTier', 'credits',
                         'totalGenerations', 'preferredLanguage', 'darkTheme',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'email', 'planTier', 'credits',
                         'totalGenerations', 'preferredLanguage', 'darkTheme',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().planTier == 'FREE' &&
                       incoming().credits == 50 &&
                       incoming().totalGenerations == 0 &&
                       isValidUserProfile(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().planTier == existing().planTier &&
                       (
                         incoming().diff(existing()).affectedKeys().hasOnly(['preferredLanguage', 'darkTheme', 'updatedAt']) ||
                         (
                           incoming().diff(existing()).affectedKeys().hasOnly(['credits', 'totalGenerations', 'updatedAt']) &&
                           incoming().credits <= existing().credits + 10
                         ) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])
                       );

      allow delete: if false;

      match /projects/{projectId} {
        allow get: if isOwner(userId) && isValidId(projectId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(projectId) &&
                         incoming().keys().hasAll([
                           'userId', 'title', 'projectType', 'prompt', 'style',
                           'aspectRatio', 'resolution', 'status', 'creditCost',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'title', 'projectType', 'prompt', 'enhancedPrompt',
                           'style', 'aspectRatio', 'resolution', 'status', 'creditCost',
                           'localMediaPath', 'interactionId', 'scriptJson',
                           'subtitlesJson', 'errorMessage', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidStudioProject(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(projectId) &&
                         isValidStudioProject(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().projectType == existing().projectType &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'enhancedPrompt', 'status', 'localMediaPath',
                           'interactionId', 'scriptJson', 'subtitlesJson',
                           'errorMessage', 'updatedAt'
                         ]) &&
                         (
                           existing().status in ['QUEUED', 'PROCESSING'] ||
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'title', 'subtitlesJson', 'localMediaPath', 'interactionId', 'updatedAt'
                           ])
                         );

        allow delete: if isOwner(userId) && isValidId(projectId);
      }
    }
  }
}
